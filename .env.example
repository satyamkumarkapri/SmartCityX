# SmartCityX Environment Variables

# Frontend Configuration
FRONTEND_URL=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8080

# Backend Configuration
BACKEND_URL=http://localhost:8080
JWT_SECRET=replace_this_with_a_secure_jwt_secret_key_for_production

# Database Configuration (Neon Serverless Postgres)
# Example: jdbc:postgresql://ep-curly-snow-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=jdbc:postgresql://<your-neon-host>/neondb?sslmode=require
DATABASE_USERNAME=your_neon_username
DATABASE_PASSWORD=your_neon_password
